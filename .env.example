# Anthropic API — required
ANTHROPIC_API_KEY=sk-ant-...

# Planner model (defaults shown)
# ANTHROPIC_MODEL=claude-fable-5
# ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8

# Server
PORT=3000
TIMEZONE=America/New_York
DAY_START=08:00
DAY_END=21:00

# Google Calendar (create an OAuth "Web application" client in Google Cloud Console;
# add http://localhost:3000/oauth2callback as an authorized redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_CALENDAR_ID=primary

# Optional shared secret for /api/message (use with the iOS Shortcut over the internet)
APP_API_KEY=
