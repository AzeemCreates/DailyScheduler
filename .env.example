# Planner backend: "ollama" (local, always-running, no API key) or "anthropic" (hosted)
PLANNER_PROVIDER=ollama

# --- Ollama (local) ---------------------------------------------------------
# Install: https://ollama.com — then `ollama pull qwen3:8b` and leave
# `ollama serve` running (it stays up in the background on install).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Anthropic (hosted) — only used when PLANNER_PROVIDER=anthropic --------
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-fable-5
# ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8

# Server
PORT=5000
TIMEZONE=America/New_York
DAY_START=08:00
DAY_END=21:00

# Google Calendar (create an OAuth "Web application" client in Google Cloud Console;
# add http://localhost:5000/oauth2callback as an authorized redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_CALENDAR_ID=primary

# Optional shared secret for /api/message (use with the iOS Shortcut over the internet)
APP_API_KEY=
